# App
NEXTAUTH_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-me
AUTH_SECRET=replace-me

# Google OAuth — create a Web client in Google Cloud Console
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me

# MongoDB Atlas (or any MongoDB replica set)
MONGODB_URI=replace-me

# Groq chat. Same OpenAI-compatible setup as the portfolio bot.
GROQ_API_KEY=replace-me
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Embeddings use Gemini. Answers stay on Groq.
# auto tries Gemini, then Groq, then a local word hash.
# Force one of: auto | gemini | groq | xai | local
EMBEDDING_PROVIDER=gemini
GROQ_EMBEDDING_MODEL=nomic-embed-text-v1_5
XAI_API_KEY=
XAI_EMBEDDING_MODEL=v1
GEMINI_API_KEY=replace-me
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Invitation emails are sent from this Gmail account.
# SMTP_PASS is a Google app password for that mailbox, not the normal Gmail password.
INVITE_FROM_EMAIL=replace-me
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASS=replace-me

# Vector search: memory works on any MongoDB.
# atlas uses MongoDB Atlas Vector Search. See the README for the index.
VECTOR_SEARCH=memory
ATLAS_VECTOR_INDEX=chunk_vector_index
