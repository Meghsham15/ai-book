# App
NEXTAUTH_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-me
AUTH_SECRET=replace-me

# Google OAuth — create a Web client in Google Cloud Console
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me

# MongoDB Atlas (or any MongoDB replica set)
MONGODB_URI=replace-me

# NVIDIA NIM. Answers and embeddings both use this key.
# Chat: https://integrate.api.nvidia.com/v1/chat/completions
# Embeddings: https://integrate.api.nvidia.com/v1/embeddings
NVIDIA_API_KEY=replace-me
NVIDIA_CHAT_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-8b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Reasoning is off so library answers stream as normal text.
NVIDIA_ENABLE_THINKING=false
# Native size of nemotron-3.5-embed-8b. The Atlas index must use this same number.
NVIDIA_EMBEDDING_DIMENSIONS=4096

# Embeddings. auto tries NVIDIA, then Gemini, then Groq, then a local word hash.
# Force one of: auto | nvidia | gemini | groq | xai | local
EMBEDDING_PROVIDER=nvidia
GROQ_API_KEY=
GROQ_EMBEDDING_MODEL=nomic-embed-text-v1_5
XAI_API_KEY=
XAI_EMBEDDING_MODEL=v1
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Invitation emails are sent from this Gmail account.
# SMTP_PASS is a Google app password for that mailbox, not the normal Gmail password.
INVITE_FROM_EMAIL=replace-me
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASS=replace-me

# Vector search: memory works on any MongoDB.
# atlas uses MongoDB Atlas Vector Search. See the README for the index.
VECTOR_SEARCH=memory
ATLAS_VECTOR_INDEX=nvidia_chunk_vector_index
